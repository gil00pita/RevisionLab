{
  "name": "revisionlab-example",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:package": "npm run build --workspace revisionlab",
    "dev": "npm run build:package && next dev --webpack",
    "build": "npm run build:package && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test:package": "npm run test --workspace revisionlab",
    "test:release": "node --test scripts/*.test.mjs",
    "release:check": "node scripts/check-release.mjs",
    "release:pack": "npm pack --workspace revisionlab"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.37.0",
    "@emotion/react": "^11.14.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "revisionlab": "file:packages/revisionlab"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "typescript": "^5"
  }
}
