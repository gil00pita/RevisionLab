# Local development on localhost needs no configuration.
# For shared review, configure these values on the Next.js deployment.
REVISIONLAB_DATABASE_URL=
REVISIONLAB_DATABASE_AUTH_TOKEN=
REVISIONLAB_OWNER_EMAIL=
RESEND_API_KEY=
REVISIONLAB_EMAIL_FROM=
# Canonical origin used for passwordless login and workspace links.
REVISIONLAB_SYSTEM_URL=
